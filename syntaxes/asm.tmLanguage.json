{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "Custom 16-Bit Assembly",
    "scopeName": "source.custom-asm",
    "patterns": [
        { "include": "#comments" },
        { "include": "#directives" },
        { "include": "#opcodes-memory" },
        { "include": "#opcodes-alu" },
        { "include": "#opcodes-jump" },
        { "include": "#opcodes-system" },
        { "include": "#registers" },
        { "include": "#labels-definition" },
        { "include": "#brackets-and-operators" },
        { "include": "#numbers" },
        { "include": "#strings" }
    ],
    "repository": {
        "comments": {
            "patterns": [
                {
                    "name": "comment.line.semicolon.assembly",
                    "match": ";.*$"
                },
                {
                    "name": "comment.line.double-slash.assembly",
                    "match": "//.*$"
                }
            ]
        },
        "directives": {
            "patterns": [
                {
                    "name": "storage.type.directive.assembly",
                    "match": "(?i)\\b(DW|DUP)\\b"
                }
            ]
        },
        "opcodes-memory": {
            "patterns": [
                {
                    "name": "custom.instruction.memory",
                    "match": "(?i)\\b(LOAD|STOR|LDR|LAD|STR|MOV|MOVI|PUSH|POP|XCHG|INN|OUTT)\\b"
                }
            ]
        },
        "opcodes-alu": {
            "patterns": [
                {
                    "name": "custom.instruction.alu",
                    "match": "(?i)\\b(ADD|ADDI|ADDM|SUB|SUBI|SUBM|MUL|MULI|DIV|DIVI|INC|DEC|ANDD|ANDI|ORR|ORI|XORR|XORI|NOTT|SHL|SHLI|SHR|SHRI|ROLL|ROLI|RORR|RORI|CMP|CMPI|TEST)\\b"
                }
            ]
        },
        "opcodes-jump": {
            "patterns": [
                {
                    "name": "custom.instruction.jump",
                    "match": "(?i)\\b(JMP|JZ|JE|JNZ|JNE|JC|JNC|JS|JNS|JA|JG|REF|JL|JAE|JBE|CALL|RET|LOOP)\\b"
                }
            ]
        },
        "opcodes-system": {
            "patterns": [
                {
                    "name": "custom.instruction.system",
                    "match": "(?i)\\b(BOOT|NOP|CLC|STC|CLR|HALT)\\b"
                }
            ]
        },
        "registers": {
            "patterns": [
                {
                    "name": "custom.register",
                    "match": "(?i)\\b(R[0-6]|SP|FLAGS?|AX|BX|CX|DX|BP|DI|SI)\\b"
                }
            ]
        },
        "labels-definition": {
            "patterns": [
                {
                    "name": "entity.name.function.label.assembly",
                    "match": "^[A-Za-z_][A-Za-z0-9_]*:"
                }
            ]
        },
        "brackets-and-operators": {
            "patterns": [
                {
                    "name": "punctuation.bracket.square.assembly",
                    "match": "[\\[\\]]"
                },
                {
                    "name": "keyword.operator.math.assembly",
                    "match": "[\\+\\-\\*/]"
                }
            ]
        },
        "numbers": {
            "patterns": [
                {
                    "name": "constant.numeric.hex.assembly",
                    "match": "(?i)\\b(0x[0-9a-f_]+|[0-9a-f_]+h)\\b"
                },
                {
                    "name": "constant.numeric.binary.assembly",
                    "match": "(?i)\\b([01_]+b|0b[01_]+)\\b"
                },
                {
                    "name": "constant.numeric.decimal.assembly",
                    "match": "\\b[0-9]+\\b"
                }
            ]
        },
        "strings": {
            "patterns": [
                {
                    "name": "string.quoted.single.assembly",
                    "match": "'[^']*'"
                },
                {
                    "name": "string.quoted.double.assembly",
                    "match": "\"[^\"]*\""
                }
            ]
        }
    }
}
